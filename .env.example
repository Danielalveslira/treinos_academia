# API e chave pública (anon/publishable) do projeto Supabase usado por este frontend.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Supabase local sem [auth.captcha]: deixe false. Para Supabase hospedado,
# use true (ou omita a variável) e configure a Site Key pública correspondente.
# false com URL hospedada é um erro de configuração e bloqueia Auth no cliente.
VITE_HCAPTCHA_ENABLED=false
VITE_HCAPTCHA_SITE_KEY=

# Chave pública opcional de Web Push; nunca insira a chave privada aqui.
VITE_VAPID_PUBLIC_KEY=
