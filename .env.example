# Configurações públicas do Firebase (seguras para o frontend)
# Obtenha em: Console do Firebase > Configurações do projeto > Seus apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Defina como "true" para usar os emuladores locais do Firebase em desenvolvimento
VITE_USE_FIREBASE_EMULATOR=false

# App Check (proteção contra scripts/bots batendo direto na API do Firebase).
# Chave do reCAPTCHA v3: Console do Firebase > Compilação > App Check > Apps > Web app > Registrar.
# Sem essa chave definida, o app funciona normalmente sem App Check (nada quebra).
VITE_RECAPTCHA_SITE_KEY=

# Opcional: token fixo pra debug local (Console do Firebase > App Check > Apps > seu app >
# Gerenciar tokens de depuração > Adicionar token de depuração). Sem isso, um token de
# debug novo é impresso no console do navegador a cada `npm run dev` — funciona igual,
# só muda a cada vez, então esse valor evita ter que recadastrar toda hora.
VITE_APPCHECK_DEBUG_TOKEN=
