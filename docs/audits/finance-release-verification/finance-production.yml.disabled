# REVIEW TEMPLATE ONLY. No workflow is registered from this directory.
# Enable under .github/workflows ONLY after the main/environment protections,
# off-site recovery proof, signed commit and Vercel hold have been verified.
name: Finance controlled frontend release
on:
  workflow_dispatch:
    inputs:
      approved_sha:
        description: Exact main SHA approved for backend and frontend
        required: true
        type: string
permissions:
  contents: read
  actions: read
concurrency:
  group: evolutus-production-release
  cancel-in-progress: false
defaults:
  run:
    shell: bash
env:
  VERCEL_PROJECT_ID: prj_WYVlCGYu021KZCrqfp62qRH2cbIE
  VERCEL_ORG_ID: ${{ vars.VERCEL_ORG_ID }}
  VERCEL_CLI_VERSION: ${{ vars.VERCEL_CLI_VERSION }}
jobs:
  verify:
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Require enabled gate, exact main commit and successful CI
        env:
          GH_TOKEN: ${{ github.token }}
          APPROVED_SHA: ${{ inputs.approved_sha }}
          RELEASE_ENABLED: ${{ vars.FINANCE_RELEASE_ENABLED }}
        run: |
          set -euo pipefail
          test "$RELEASE_ENABLED" = true
          test "$GITHUB_SHA" = "$APPROVED_SHA"
          test "$(gh api "repos/$GITHUB_REPOSITORY/commits/main" --jq .sha)" = "$APPROVED_SHA"
          gh api "repos/$GITHUB_REPOSITORY/actions/workflows/supabase-tests.yml/runs?head_sha=$APPROVED_SHA&status=success" > /tmp/ci.json
          node -e 'const x=require("/tmp/ci.json");if(!x.workflow_runs.some(r=>r.head_sha===process.env.APPROVED_SHA&&r.head_branch==="main"&&r.conclusion==="success"))process.exit(1)'

  backend:
    needs: verify
    environment: finance-production-backend
    runs-on: ubuntu-latest
    timeout-minutes: 10
    # Environment reviewer verifies off-site backup AND exact eight Edge versions.
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: 24
          cache: npm
      - run: npm ci
      - name: Require recorded backup and backend approval for this SHA
        env:
          BACKEND_APPROVED_SHA: ${{ vars.FINANCE_BACKEND_APPROVED_SHA }}
          RECOVERY_APPROVED_SHA: ${{ vars.FINANCE_RECOVERY_APPROVED_SHA }}
        run: |
          set -euo pipefail
          test "$BACKEND_APPROVED_SHA" = "$GITHUB_SHA"
          test "$RECOVERY_APPROVED_SHA" = "$GITHUB_SHA"
      - name: Verify backend in read-only transaction
        env:
          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
        run: |
          set -euo pipefail
          umask 077
          node_modules/.bin/supabase projects list --output json > /tmp/projects.json
          node -e 'const p=require("/tmp/projects.json");if(!p.some(x=>x.id==="ywrjojrjgozdfpddkkuy"))process.exit(1)'
          # link establishes access metadata; does not deploy or migrate.
          node_modules/.bin/supabase link --project-ref ywrjojrjgozdfpddkkuy
          node_modules/.bin/supabase db query --linked --file scripts/release/finance-postdeploy-readonly.sql --output json > /tmp/finance-postdeploy.json
          node scripts/release/check-finance-diagnostics.mjs after /tmp/finance-postdeploy.json

  stage:
    needs: backend
    environment: finance-production-stage
    runs-on: ubuntu-latest
    timeout-minutes: 20
    outputs:
      url: ${{ steps.deploy.outputs.url }}
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: 24
          cache: npm
      - run: npm ci
      - name: Install reviewed CLI version
        run: |
          set -euo pipefail
          [[ "$VERCEL_CLI_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
          npm install --global "vercel@$VERCEL_CLI_VERSION"
      - name: Verify Vercel identity and production hold
        env:
          VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
        run: |
          set -euo pipefail
          node scripts/release/vercel-production-gate.mjs > /tmp/vercel-gate.json
          node -e 'if(require("/tmp/vercel-gate.json").autoAssignCustomDomains!==false)process.exit(1)'
      - run: vercel pull --yes --environment=production --scope danielalvesliras-projects
        env:
          VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
      - run: vercel build --prod
      - run: node scripts/release/scan-secrets.mjs --dist
      - id: deploy
        env:
          VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
        run: |
          set -euo pipefail
          deployment_url="$(vercel deploy --prebuilt --prod --skip-domain --scope danielalvesliras-projects --meta githubCommitSha="$GITHUB_SHA")"
          DEPLOYMENT_URL="$deployment_url" node --input-type=module -e 'const v=process.env.DEPLOYMENT_URL;const u=new URL(v);if(u.protocol!=="https:"||u.origin!==v||!u.hostname.endsWith(".vercel.app"))process.exit(1)'
          printf 'url=%s\n' "$deployment_url" >> "$GITHUB_OUTPUT"

  promote:
    needs: stage
    # Separate required reviewer: test staged URL, login/session and wallet READS.
    # No fabricated purchases, refunds or SQL fixtures in production.
    environment: finance-production-promote
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: 24
      - name: Install reviewed CLI version
        run: |
          set -euo pipefail
          [[ "$VERCEL_CLI_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
          npm install --global "vercel@$VERCEL_CLI_VERSION"
      - name: Promote the SAME staged production build after smoke approval
        env:
          VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
          DEPLOYMENT_URL: ${{ needs.stage.outputs.url }}
        run: |
          set -euo pipefail
          vercel inspect "$DEPLOYMENT_URL" --scope danielalvesliras-projects
          vercel promote "$DEPLOYMENT_URL" --scope danielalvesliras-projects
