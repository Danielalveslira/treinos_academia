{
  "git": { "deploymentEnabled": { "finance-ci-*": false, "chore/finance-release-readiness": false } },
  "redirects": [
    { "source": "/:page(como-funciona|para-empresas|vitrine|profissionais).html", "destination": "/:page", "statusCode": 301 },
    { "source": "/:page(como-funciona|para-empresas|vitrine|profissionais)/", "destination": "/:page", "statusCode": 301 },
    {
      "source": "/:path((?!assets/|icons/|_vercel/|.*\\.[\\w]+$).*)",
      "has": [{ "type": "host", "value": "treinosacademia-ten.vercel.app" }],
      "destination": "https://www.evolutus.com.br/:path*",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/como-funciona", "destination": "/como-funciona.html" },
    { "source": "/para-empresas", "destination": "/para-empresas.html" },
    { "source": "/vitrine", "destination": "/vitrine.html" },
    { "source": "/profissionais", "destination": "/profissionais.html" },
    {
      "source": "/:path((?:app|login|cadastro|esqueci-senha|confirmar-email|redefinir-senha|regras-da-comunidade|termos-de-uso|politica-de-privacidade|termos-publicacao-vitrine|atendimento|profissionais/[^/]+|exercicios(?:/[^/]+)?|novo-treino|historico|progresso|perfil|evocash|entenda-suas-moedas|minhas-promocoes|meus-anuncios|minha-vitrine|comunidades(?:/.*)?|admin/(?:compras-evocash|moderacao|contas|vitrines|exclusao-contas|comunidades|parcerias|promocoes|exercicios(?:-imagens)?)))",
      "destination": "/app-shell.html"
    }
  ],
  "headers": [
    {
      "source": "/(index|app-shell|como-funciona|para-empresas|vitrine|profissionais).html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://ywrjojrjgozdfpddkkuy.supabase.co wss://ywrjojrjgozdfpddkkuy.supabase.co https://firebasestorage.googleapis.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/boot-(.*).js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
