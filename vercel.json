{
  "git": {
    "deploymentEnabled": {
      "finance-ci-*": false,
      "chore/finance-release-readiness": false
    }
  },
  "redirects": [
    {
      "source": "/:page(como-funciona|para-empresas|informacoes-do-fornecedor|vitrine|profissionais|locais|demo|demo-preview).html",
      "destination": "/:page",
      "statusCode": 301
    },
    {
      "source": "/:page(como-funciona|para-empresas|informacoes-do-fornecedor|vitrine|profissionais|locais|demo|demo-preview)/",
      "destination": "/:page",
      "statusCode": 301
    },
    {
      "source": "/:path((?!assets/|icons/|_vercel/|.*\\.[\\w]+$).*)",
      "has": [
        {
          "type": "host",
          "value": "treinosacademia-ten.vercel.app"
        }
      ],
      "destination": "https://www.evolutus.com.br/:path*",
      "statusCode": 301
    }
  ],
  "functions": {
    "api/storefront-catalog.js": {
      "includeFiles": "dist/vitrine.html"
    },
    "api/storefront-sitemap.js": {
      "includeFiles": "dist/sitemap.xml"
    },
    "api/listings.js": {
      "includeFiles": "dist/{profissionais,locais}.html"
    }
  },
  "rewrites": [
    {
      "source": "/profissionais/:id([0-9a-fA-F-]{36})",
      "destination": "/api/listings?kind=professional&id=:id"
    },
    {
      "source": "/locais/:id([0-9a-fA-F-]{36})",
      "destination": "/api/listings?kind=space&id=:id"
    },
    {
      "source": "/profissionais",
      "destination": "/api/listings?kind=professional"
    },
    {
      "source": "/locais",
      "destination": "/api/listings?kind=space"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/storefront-sitemap"
    },
    {
      "source": "/como-funciona",
      "destination": "/como-funciona.html"
    },
    {
      "source": "/demo",
      "destination": "/demo.html"
    },
    {
      "source": "/demo-preview",
      "destination": "/demo-preview.html"
    },
    {
      "source": "/para-empresas",
      "destination": "/para-empresas.html"
    },
    {
      "source": "/informacoes-do-fornecedor",
      "destination": "/informacoes-do-fornecedor.html"
    },
    {
      "source": "/vitrine/:id([0-9a-fA-F-]{36})",
      "destination": "/api/storefront?id=:id"
    },
    {
      "source": "/vitrine",
      "destination": "/api/storefront-catalog"
    },
    {
      "source": "/:path((?:app|login|cadastro|esqueci-senha|confirmar-email|redefinir-senha|regras-da-comunidade|termos-de-uso|politica-de-privacidade|termos-publicacao-vitrine|condicoes-evocash|termos-publicidade|politica-de-reembolso|atendimento|profissionais/[^/]+|exercicios(?:/[^/]+)?|fichas(?:/[^/]+)?(?:/editar)?|treinar|novo-treino|historico|progresso|perfil|evocash|entenda-suas-moedas|minhas-promocoes|meus-anuncios|vitrine/gerenciar|minha-vitrine|comunidades(?:/.*)?|admin/(?:compras-evocash|moderacao|contas|vitrines|exclusao-contas|comunidades|parcerias|promocoes|exercicios(?:-imagens)?)))",
      "destination": "/app-shell.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/evolutus-build.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(index|app-shell|como-funciona|para-empresas|informacoes-do-fornecedor|vitrine|profissionais|demo|demo-preview).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://hcaptcha.com https://*.hcaptcha.com; style-src 'self' 'unsafe-inline' https://hcaptcha.com https://*.hcaptcha.com; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://ywrjojrjgozdfpddkkuy.supabase.co wss://ywrjojrjgozdfpddkkuy.supabase.co https://firebasestorage.googleapis.com https://hcaptcha.com https://*.hcaptcha.com; frame-src https://hcaptcha.com https://*.hcaptcha.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/boot-(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
