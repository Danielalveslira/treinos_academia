rules_version = '2';

// O Storage permite no máximo duas consultas a documentos distintos do Firestore por
// avaliação. A autorização completa da publicação acontece ao criar statuses/{id}; o
// upload apenas confirma esse documento já autorizado. A leitura confirma o status e
// a filiação do leitor, totalizando exatamente duas consultas.
service firebase.storage {
  match /b/{bucket}/o {
    match /profileAvatars/{userId}/{fileName} {
      function avatarManifest() {
        return firestore.get(
          /databases/(default)/documents/profileAvatarMedia/$(fileName.replace('[.]webp$', ''))
        ).data;
      }

      allow read: if request.auth != null
        && firestore.get(/databases/(default)/documents/publicProfiles/$(userId)).data.avatarPath
          == 'profileAvatars/' + userId + '/' + fileName;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && resource == null
        && fileName.matches('^[A-Za-z0-9]{20}\\.webp$')
        && request.resource.size > 0
        && request.resource.size <= 1024 * 1024
        && request.resource.contentType == 'image/webp'
        && avatarManifest().ownerId == userId
        && avatarManifest().storagePath == 'profileAvatars/' + userId + '/' + fileName
        && avatarManifest().state == 'allocated';
      allow update, delete: if false;
    }

    match /professionalListingMedia/{listingId}/approved/{fileName} {
      function publishedListing() {
        return firestore.get(
          /databases/(default)/documents/publishedProfessionalListings/$(listingId)
        ).data;
      }

      allow read: if fileName.matches('^[A-Za-z0-9]{20}\\.webp$')
        && publishedListing().publicationStatus == 'published'
        && publishedListing().avatarPath
          == 'professionalListingMedia/' + listingId + '/approved/' + fileName;
      allow write: if false;
    }

    // Catálogo estático público: a URL é derivada de catalog.json, sem consulta ao
    // Firestore. Clientes nunca escrevem neste namespace; somente o pipeline local com
    // Admin SDK (que não passa pelas Rules) pode publicar arquivos versionados.
    match /exercise-catalog/{version}/{exerciseId}/{fileName} {
      allow read: if version.matches('^v[0-9]+$')
        && exerciseId.matches('^[A-Za-z0-9_() .-]+$')
        && exerciseId != '.'
        && exerciseId != '..'
        && fileName.matches('^(thumb|[0-9]+)\\.webp$');
      allow write: if false;
    }

    match /statusPhotos/{communityId}/{fileName} {
      function statusId() {
        return fileName.replace('[.]webp$', '');
      }

      function statusPath() {
        return /databases/(default)/documents/statuses/$(statusId());
      }

      function validPhotoStatus(status) {
        return status.type == 'photo'
          && status.communityId == communityId
          && status.photoPath == 'statusPhotos/' + communityId + '/' + fileName
          && (status.expiresAt > request.time
            || (status.get('promoted', false) == true
              && status.get('promotedUntil', null) is timestamp
              && status.promotedUntil > request.time));
      }

      function canReadPhoto() {
        let status = firestore.get(statusPath()).data;
        return validPhotoStatus(status)
          && firestore.exists(
            /databases/(default)/documents/communityMembers/$(communityId + '_' + request.auth.uid)
          );
      }

      function canCreatePhoto() {
        let status = firestore.get(statusPath()).data;
        return validPhotoStatus(status)
          && status.authorId == request.auth.uid
          && request.time < status.createdAt + duration.value(10, 'm');
      }

      allow read: if request.auth != null
        && fileName.matches('^[A-Za-z0-9]{20}\\.webp$')
        && canReadPhoto();

      allow create: if request.auth != null
        && resource == null
        && fileName.matches('^[A-Za-z0-9]{20}\\.webp$')
        && request.resource.size > 0
        && request.resource.size <= 4 * 1024 * 1024
        && request.resource.contentType == 'image/webp'
        && canCreatePhoto();

      allow update, delete: if false;
    }

    // AUD-007: cópia da foto denunciada, feita pela Cloud Function submitSupportRequest
    // (Admin SDK, sem passar por estas regras) no momento da denúncia -- sobrevive
    // independente do que acontece depois com a publicação original (expiração,
    // exclusão pelo autor, exclusão da conta/comunidade). Só a moderação (superadmin)
    // lê; nenhum cliente escreve aqui diretamente.
    match /moderationEvidence/{fileName} {
      allow read: if request.auth != null
        && fileName.matches('^[A-Za-z0-9]{20}\\.webp$')
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
