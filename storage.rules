rules_version = '2';

// O Storage permite no máximo duas consultas a documentos distintos do Firestore por
// avaliação. A autorização completa da publicação acontece ao criar statuses/{id}; o
// upload apenas confirma esse documento já autorizado. A leitura confirma o status e
// a filiação do leitor, totalizando exatamente duas consultas.
service firebase.storage {
  match /b/{bucket}/o {
    match /statusPhotos/{communityId}/{fileName} {
      function statusId() {
        return fileName.replace('[.]webp$', '');
      }

      function statusPath() {
        return /databases/(default)/documents/statuses/$(statusId());
      }

      function validPhotoStatus(status) {
        return status.type == 'photo'
          && status.communityId == communityId
          && status.photoPath == 'statusPhotos/' + communityId + '/' + fileName
          && status.expiresAt > request.time;
      }

      function canReadPhoto() {
        let status = firestore.get(statusPath()).data;
        return validPhotoStatus(status)
          && firestore.exists(
            /databases/(default)/documents/communityMembers/$(communityId + '_' + request.auth.uid)
          );
      }

      function canCreatePhoto() {
        let status = firestore.get(statusPath()).data;
        return validPhotoStatus(status)
          && status.authorId == request.auth.uid
          && request.time < status.createdAt + duration.value(10, 'm');
      }

      // Compatibilidade temporária com versões instaladas antes da mudança de ordem do
      // fluxo. Elas enviam os bytes antes de criar statuses/{id}. O Firestore ainda faz
      // a autorização completa logo depois do upload; se negar ou o cliente desaparecer,
      // purgeOrphanedPhotos remove o arquivo sem status. Esta alternativa usa apenas os
      // dois documentos permitidos pelo Storage e mantém assinatura/conta bloqueada fora.
      function canLegacyCreatePhoto() {
        let me = firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data;
        let sub = me.get('subscription', null);
        let subscriptionOk = sub != null
          && ((sub.paidAt == null && request.time < sub.trialEndsAt)
            || (sub.paidAt != null && sub.graceEndsAt != null && request.time < sub.graceEndsAt));
        return firestore.exists(
            /databases/(default)/documents/communityMembers/$(communityId + '_' + request.auth.uid)
          )
          && me.get('accountStatus', 'active') != 'disabled'
          && me.get('accountStatus', 'active') != 'deleting'
          && (me.get('role', 'user') == 'superadmin' || subscriptionOk);
      }

      allow read: if request.auth != null
        && fileName.matches('^[A-Za-z0-9]{20}\\.webp$')
        && canReadPhoto();

      allow create: if request.auth != null
        && resource == null
        && fileName.matches('^[A-Za-z0-9]{20}\\.webp$')
        && request.resource.size > 0
        && request.resource.size <= 4 * 1024 * 1024
        && request.resource.contentType == 'image/webp'
        && canCreatePhoto();

      allow create: if request.auth != null
        && resource == null
        && fileName.matches('^[A-Za-z0-9]{20}\\.webp$')
        && request.resource.size > 0
        && request.resource.size <= 4 * 1024 * 1024
        && request.resource.contentType == 'image/webp'
        && canLegacyCreatePhoto();

      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
