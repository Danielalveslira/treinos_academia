rules_version = '2';

// Fotos de publicações de comunidade. O nome do arquivo nunca vem do usuário: o
// cliente sempre envia para "{communityId}/{20 caracteres alfanuméricos}.webp",
// o mesmo formato de ID que o Firestore gera para o documento do status (ver
// createPhotoStatus em statusesService.js e isValidStatusContent no
// firestore.rules, que exige que photoPath bata com esse padrão).
//
// As checagens abaixo (hasAppAccess, communityAccessAllowed, communityAllowsPosting)
// espelham exatamente as funções de mesmo nome em firestore.rules — pertencer à
// comunidade (isMember) nunca foi suficiente sozinho: assinatura vencida, conta
// desativada, suspensão de conta, banimento na comunidade, aceite legal pendente e
// publicação restrita a admins (postAccess) bloqueiam a publicação no Firestore, e
// precisam bloquear o arquivo em si também — senão o Storage vira uma porta lateral
// para ler e enviar fotos sem passar por nenhuma dessas regras.
//
// Validado manualmente (scripts isolados de @firebase/rules-unit-testing, fora da
// suíte automatizada): sem auth nega; sem filiação na comunidade do caminho nega;
// nome de arquivo fora do formato nega; tipo diferente de image/webp nega; acima de
// 4MB nega; reenvio para um caminho já existente nega (resource == null); update e
// delete nunca são permitidos ao cliente; assinatura vencida, conta desativada,
// suspensão, banimento na comunidade, aceite legal pendente e postAccess: 'admins'
// (para não-superadmin) negam tanto leitura quanto envio. Não entrou em
// tests/*rules.test.mjs porque, nesta versão do @firebase/rules-unit-testing,
// configurar `storage` e `firestore.rules` no mesmo initializeTestEnvironment quebra
// de forma reprodutível a ponte firestore.exists()/firestore.get() usada abaixo (toda
// checagem cruzada passa a negar, mesmo com o documento certo no lugar certo) — uma
// limitação da ferramenta de teste local, não das regras em si. Revisitar se a
// dependência for atualizada.
service firebase.storage {
  match /b/{bucket}/o {
    match /statusPhotos/{communityId}/{fileName} {
      function isMember() {
        return request.auth != null
          && firestore.exists(
            /databases/(default)/documents/communityMembers/$(communityId + '_' + request.auth.uid)
          );
      }

      function isSuperAdmin() {
        return request.auth != null
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
      }

      function hasCurrentAcceptance() {
        let policy = /databases/(default)/documents/legalPolicy/current;
        return !firestore.exists(policy) || firestore.get(policy).data.published != true
          || (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.legalAcceptance.version == firestore.get(policy).data.version
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.legalAcceptance.digest == firestore.get(policy).data.digest);
      }

      function isAccountDisabled() {
        let me = /databases/(default)/documents/users/$(request.auth.uid);
        return firestore.exists(me) && firestore.get(me).data.get('accountStatus', 'active') == 'disabled';
      }

      function subscriptionAllowsAccess() {
        let me = /databases/(default)/documents/users/$(request.auth.uid);
        let sub = firestore.get(me).data.get('subscription', null);
        return sub != null
          && ((sub.paidAt == null && request.time < sub.trialEndsAt)
            || (sub.paidAt != null && sub.graceEndsAt != null && request.time < sub.graceEndsAt));
      }

      function hasAppAccess() {
        let restriction = /databases/(default)/documents/accountRestrictions/$(request.auth.uid);
        return request.auth != null && hasCurrentAcceptance()
          && (isSuperAdmin() || (!isAccountDisabled() && subscriptionAllowsAccess()))
          && (!firestore.exists(restriction)
            || (firestore.get(restriction).data.action == 'temporary_suspension'
              && firestore.get(restriction).data.until <= request.time));
      }

      function communityAccessAllowed() {
        return !firestore.exists(/databases/(default)/documents/deletionJobs/$('community_' + communityId))
          && !firestore.exists(/databases/(default)/documents/communityRestrictions/$(communityId + '_' + request.auth.uid));
      }

      function communityAllowsPosting() {
        return firestore.get(/databases/(default)/documents/communities/$(communityId)).data.get('postAccess', 'everyone') != 'admins'
          || isSuperAdmin();
      }

      allow read: if isMember() && hasAppAccess() && communityAccessAllowed();

      // Só cria; nunca sobrescreve nem apaga. resource == null é o que de fato torna
      // isso um "só cria": no Storage, reenviar bytes para um caminho que já tem um
      // arquivo passa pela mesma regra de "create" (não existe update de conteúdo,
      // só de metadata) — sem essa checagem, um reenvio para o mesmo nome de arquivo
      // seria aceito como se fosse a primeira vez. A limpeza (exclusão manual,
      // decisão de moderação ou expiração em 24h) é sempre feita pelo Admin SDK nas
      // Cloud Functions — nunca pelo próprio cliente, mesmo o autor original.
      allow create: if isMember()
        && hasAppAccess()
        && communityAccessAllowed()
        && communityAllowsPosting()
        && resource == null
        && fileName.matches('^[A-Za-z0-9]{20}\\.webp$')
        && request.resource.size > 0
        && request.resource.size <= 4 * 1024 * 1024
        && request.resource.contentType == 'image/webp';
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
