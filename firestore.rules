rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasCurrentAcceptance() {
      let policy = /databases/$(database)/documents/legalPolicy/current;
      return !exists(policy) || get(policy).data.published != true
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.legalAcceptance.version == get(policy).data.version
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.legalAcceptance.digest == get(policy).data.digest);
    }

    function isAccountDisabled() {
      let me = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(me) && get(me).data.get('accountStatus', 'active') == 'disabled';
    }

    // Deriva o acesso à assinatura só a partir de carimbos do servidor (trialEndsAt,
    // graceEndsAt) em vez de um campo de status mutável — assim não depende de um job
    // periódico para "virar" o estado no momento exato em que o tempo passa.
    function subscriptionAllowsAccess() {
      let me = /databases/$(database)/documents/users/$(request.auth.uid);
      let sub = get(me).data.get('subscription', null);
      return sub != null
        && ((sub.paidAt == null && request.time < sub.trialEndsAt)
          || (sub.paidAt != null && sub.graceEndsAt != null && request.time < sub.graceEndsAt));
    }

    function hasAppAccess() {
      let restriction = /databases/$(database)/documents/accountRestrictions/$(request.auth.uid);
      return isSignedIn() && hasCurrentAcceptance()
        && (isSuperAdmin() || (!isAccountDisabled() && subscriptionAllowsAccess()))
        && (!exists(restriction)
          || (get(restriction).data.action == 'temporary_suspension'
            && get(restriction).data.until <= request.time));
    }

    function communityAccessAllowed(communityId) {
      return !exists(/databases/$(database)/documents/communityRestrictions/$(communityId + '_' + request.auth.uid));
    }

    match /legalPolicy/{policyId} {
      allow get: if true;
      allow write: if false;
    }

    match /legalVersions/{version} {
      allow get: if true;
      allow write: if false;
    }

    match /accountRestrictions/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow write: if false;
    }

    match /communityRestrictions/{restrictionId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /supportRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow write: if false;
    }

    match /moderationDecisions/{decisionId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Nomes/preços dos planos: leitura pública (a página de planos é acessível a
    // visitantes deslogados). Escrita só pelo SUPERADMIN.
    match /appConfig/plans {
      allow get: if true;
      allow write: if isSuperAdmin();
    }

    // Chave PIX, WhatsApp e nome do recebedor: dado pessoal do dono do negócio, não
    // precisa (nem deveria) ficar raspável por qualquer bot da internet — só quem tem
    // conta enxerga, o suficiente pra ver a tela de pagamento depois de logar.
    match /appConfig/billing {
      allow get: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Histórico de pagamentos confirmados: só o SUPERADMIN lê; escrita apenas
    // pela Cloud Function confirmPayment (Admin SDK, ignora estas regras).
    match /payments/{paymentId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    function isValidExercise(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && data.muscleGroup is string && data.muscleGroup.size() > 0
        && data.active is bool
        && (!('note' in data) || data.note is string && data.note.size() <= 300);
    }

    function isValidWorkout(data) {
      return data.exerciseId is string && data.exerciseId.size() > 0
        && data.weight is number && data.weight >= 0
        && data.sets is int && data.sets > 0
        && data.reps is int && data.reps > 0
        && data.date is timestamp
        && (!('note' in data) || data.note is string && data.note.size() <= 300);
    }

    function isValidUsernameField(data) {
      return !('username' in data) || data.username == null
        || (data.username is string && data.username.matches('^[a-z0-9_]{3,20}$'));
    }

    function isValidBioField(data) {
      return !('bio' in data) || data.bio == null
        || (data.bio is string && data.bio.size() <= 300);
    }

    // Documento público separado: nunca liberar leitura do perfil privado para visitantes.
    match /publicProfiles/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll(['username', 'bio', 'shareStatistics'])
        && request.resource.data.keys().hasOnly(['username', 'bio', 'shareStatistics'])
        && isValidUsernameField(request.resource.data)
        && isValidBioField(request.resource.data)
        && request.resource.data.shareStatistics is bool;

      match /statistics/{summaryId} {
        allow get: if isSignedIn()
          && get(/databases/$(database)/documents/publicProfiles/$(userId)).data.shareStatistics == true;
        allow list: if false;
        allow create, update: if isOwner(userId) && summaryId == 'summary'
          && getAfter(/databases/$(database)/documents/publicProfiles/$(userId)).data.shareStatistics == true
          && request.resource.data.keys().hasOnly(['entries', 'sets', 'updatedAt'])
          && request.resource.data.entries is int && request.resource.data.entries >= 0
          && request.resource.data.sets is number && request.resource.data.sets >= 0
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(userId);
      }
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      // Perfil sempre nasce como "user"; virar superadmin exige edição manual
      // (console/Admin SDK), nunca uma escrita vinda do cliente.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && !request.resource.data.keys().hasAny(['legalAcceptance', 'accountStatus', 'subscription'])
        && isValidUsernameField(request.resource.data)
        && isValidBioField(request.resource.data);
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['legalAcceptance', 'accountStatus', 'disabledAt', 'disabledBy', 'disabledReason', 'subscription'])
        && isValidUsernameField(request.resource.data)
        && isValidBioField(request.resource.data);

      match /exercises/{exerciseId} {
        allow read, delete: if isOwner(userId) && hasAppAccess();
        allow create, update: if isOwner(userId) && hasAppAccess() && isValidExercise(request.resource.data);
      }

      match /workouts/{workoutId} {
        allow read, delete: if isOwner(userId) && hasAppAccess();
        allow create, update: if isOwner(userId) && hasAppAccess() && isValidWorkout(request.resource.data);
      }

      match /legalAcceptances/{version} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if false;
      }

      match /notices/{noticeId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if false;
      }
    }

    // Reserva de @usuário: um documento por nome de usuário, apontando para o dono.
    // Impede duplicidade (dois usuários com o mesmo @) sem precisar de Cloud Function —
    // o cliente sempre lê aqui dentro de uma transação antes de reivindicar um nome.
    match /usernames/{username} {
      // Leitura pública: o cadastro precisa checar disponibilidade do @ antes de criar
      // a conta no Authentication (usuário ainda não está autenticado nesse momento).
      // O documento só expõe uid + createdAt, então não há dado sensível aqui.
      allow read: if true;
      allow create: if isSignedIn()
        && username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    function isValidCommunity(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && data.description is string && data.description.size() <= 300
        && (data.imageUrl == null || data.imageUrl is string)
        && data.isActive is bool
        && data.createdBy is string
        && data.createdAt is timestamp;
    }

    function communityIsActive(communityId) {
      return get(/databases/$(database)/documents/communities/$(communityId)).data.isActive == true;
    }

    match /communities/{communityId} {
      allow read: if hasAppAccess();
      allow create: if isSuperAdmin()
        && isValidCommunity(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSuperAdmin()
        && isValidCommunity(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSuperAdmin();
    }

    function expectedMembershipId(data) {
      return data.communityId + '_' + data.userId;
    }

    match /communityMembers/{membershipId} {
      // Leitura restrita: cada usuário só enxerga a própria filiação; só o
      // superadmin pode listar/contar todos os membros de uma comunidade.
      // resource == null cobre o get() de "ainda não sou membro" (documento não
      // existe): sem isso, resource.data.userId falha a avaliação e o Firestore
      // nega com permission-denied em vez de simplesmente não encontrar nada.
      allow read: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if hasAppAccess()
        && request.resource.data.userId == request.auth.uid
        && membershipId == expectedMembershipId(request.resource.data)
        && request.resource.data.joinedAt is timestamp
        && communityIsActive(request.resource.data.communityId)
        && communityAccessAllowed(request.resource.data.communityId);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    function isMember(communityId) {
      return hasAppAccess() && communityAccessAllowed(communityId)
        && exists(/databases/$(database)/documents/communityMembers/$(communityId + '_' + request.auth.uid));
    }

    function isValidStatusBase(data) {
      // createdAt precisa ser o carimbo do servidor (serverTimestamp()) — comparado aqui
      // com request.time, que é para o que ele resolve durante a validação da regra.
      // expiresAt é calculado no cliente (createdAt ainda não existe de fato na hora do
      // envio), então aceitamos uma janela de tolerância de 10 minutos ao redor de +24h
      // para absorver a latência entre o cliente montar o valor e o servidor processar.
      return data.communityId is string && data.communityId.size() > 0
        && data.authorId is string
        && data.type in ['text', 'poll', 'workout', 'achievement']
        && data.createdAt == request.time
        && data.expiresAt > request.time + duration.value(1435, 'm')
        && data.expiresAt < request.time + duration.value(1445, 'm');
    }

    function isValidStatusContent(data) {
      return (data.type == 'text' &&
          data.text is string && data.text.size() > 0 && data.text.size() <= 500)
        || (data.type == 'poll' &&
          data.poll.question is string && data.poll.question.size() > 0
          && data.poll.options is list && data.poll.options.size() >= 2 && data.poll.options.size() <= 6)
        || (data.type == 'workout' &&
          data.workout.title is string && data.workout.title.size() > 0
          && data.workout.date is timestamp
          && data.workout.location is string)
        || (data.type == 'achievement' &&
          data.achievement.keys().hasOnly(['day', 'text', 'entries', 'sets'])
          && data.achievement.day is string
          && data.achievement.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.achievement.text is string && data.achievement.text.size() <= 300
          && data.achievement.entries is int && data.achievement.entries >= 0
          && data.achievement.sets is number && data.achievement.sets >= 0
          && (data.achievement.entries > 0 || data.achievement.text.size() > 0));
    }

    match /statuses/{statusId} {
      allow read: if isSignedIn() && isMember(resource.data.communityId);
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && isMember(request.resource.data.communityId)
        && communityIsActive(request.resource.data.communityId)
        && isValidStatusBase(request.resource.data)
        && isValidStatusContent(request.resource.data);
      allow update: if isSignedIn()
        && resource.data.authorId == request.auth.uid
        && isMember(resource.data.communityId)
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.communityId == resource.data.communityId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.type == resource.data.type
        && isValidStatusContent(request.resource.data);
      allow delete: if isSignedIn()
        && (resource.data.authorId == request.auth.uid || isSuperAdmin());

      match /votes/{userId} {
        allow read: if isSignedIn() && isMember(get(/databases/$(database)/documents/statuses/$(statusId)).data.communityId);
        allow create: if isSignedIn()
          && userId == request.auth.uid
          && request.resource.data.optionId is string
          && request.resource.data.createdAt is timestamp
          && get(/databases/$(database)/documents/statuses/$(statusId)).data.type == 'poll'
          && get(/databases/$(database)/documents/statuses/$(statusId)).data.expiresAt > request.time
          && isMember(get(/databases/$(database)/documents/statuses/$(statusId)).data.communityId);
        allow update, delete: if false;
      }

      match /participants/{userId} {
        allow read: if isSignedIn() && isMember(get(/databases/$(database)/documents/statuses/$(statusId)).data.communityId);
        allow create: if isSignedIn()
          && userId == request.auth.uid
          && request.resource.data.joinedAt is timestamp
          && get(/databases/$(database)/documents/statuses/$(statusId)).data.type == 'workout'
          && get(/databases/$(database)/documents/statuses/$(statusId)).data.expiresAt > request.time
          && isMember(get(/databases/$(database)/documents/statuses/$(statusId)).data.communityId);
        allow delete: if isSignedIn() && userId == request.auth.uid;
        allow update: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
