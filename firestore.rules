rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && !exists(/databases/$(database)/documents/deletionJobs/$('account_' + request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // hasAppAccess() costumava se dividir em hasCurrentAcceptance()/isAccountDisabled()/
    // subscriptionAllowsAccess()/isSuperAdmin(), cada uma com seu próprio get() do mesmo
    // documento users/{uid} (e legalPolicy/current sendo lido com get() mais de uma vez
    // dentro da mesma função). Empilhadas numa única avaliação (isMember -> hasAppAccess,
    // no mesmo allow create de statuses), isso multiplicava a mesma leitura várias vezes
    // e estourava o limite de expressões do Firestore em produção (confirmado no
    // emulador com termos publicados: toda criação de publicação passou a ser negada com
    // "maximum of 1000 expressions"). Consolidada numa função só: users/{uid} e
    // accountRestrictions são lidos exatamente uma vez cada, e isAdmin entra como
    // parâmetro pra não precisar perguntar de novo quem já sabe (ver
    // statusAccountOk/canCreateStatus, que usam a mesma ideia para o caminho mais
    // pesado — criar uma publicação).
    function hasAppAccess(isAdmin) {
      let uid = request.auth.uid;
      let me = get(/databases/$(database)/documents/users/$(uid)).data;
      let policyRef = /databases/$(database)/documents/legalPolicy/current;
      let policyExists = exists(policyRef);
      // {} em vez de null no ramo "sem termos publicados": o Firestore rejeita um `let`
      // cujos dois ramos do ternário não têm o mesmo tipo (map vs null não compila).
      // policy.get(...) com padrão cobre o caso de policyExists == false sem nunca
      // acessar um campo que não existe.
      let policy = policyExists ? get(policyRef).data : {};
      let restrictionRef = /databases/$(database)/documents/accountRestrictions/$(uid);
      let restrictionExists = exists(restrictionRef);
      return isSignedIn()
        && (!policyExists || policy.published != true
          || (me.legalAcceptance.version == policy.version && me.legalAcceptance.digest == policy.digest))
        && (isAdmin || me.get('accountStatus', 'active') != 'disabled')
        && (isAdmin || emailVerifiedOk(me))
        && (!restrictionExists
          || (get(restrictionRef).data.action == 'temporary_suspension'
            && get(restrictionRef).data.until <= request.time));
    }

    // Espelha EMAIL_VERIFICATION_CUTOFF/requiresEmailVerification em
    // src/utils/emailVerification.js — timestamp.value() em milissegundos (não
    // timestamp.date(), que só tem granularidade de dia) pra bater exatamente com o
    // `new Date(...)` do lado do cliente; um descompasso de dia inteiro entre as duas
    // camadas deixaria uma janela de contas que o cliente considera isentas mas o
    // servidor já bloqueia (ou vice-versa), sem nenhum aviso na tela. Mesma fonte de
    // dado (users/{uid}.createdAt) nas duas camadas. Contas de antes do corte nunca
    // precisaram verificar o e-mail (decisão de produto, não é retroativo); createdAt
    // ausente cai no lado "não exige", pelo mesmo motivo defensivo do lado do cliente.
    // Chamada como função (não guardada em `let`) de propósito: hasAppAccess/
    // statusAccountOk já estão perto do teto de 10 variáveis por função que já causou
    // incidente em produção (ver comentário acima).
    function emailVerifiedOk(me) {
      return me.get('createdAt', timestamp.value(0)) < timestamp.value(1789136100000)
        || request.auth.token.get('email_verified', false) == true;
    }

    function communityAccessAllowed(communityId) {
      return !exists(/databases/$(database)/documents/deletionJobs/$('community_' + communityId))
        && !exists(/databases/$(database)/documents/communityRestrictions/$(communityId + '_' + request.auth.uid));
    }

    match /legalPolicy/{policyId} {
      allow get: if true;
      allow write: if false;
    }

    match /legalVersions/{version} {
      allow get: if true;
      allow write: if false;
    }

    // Documento jurídico específico da Vitrine. É público para permitir leitura antes
    // do aceite, mas não participa de hasAppAccess() e nunca bloqueia o restante do app.
    match /showcaseLegalPolicy/{policyId} {
      allow get: if true;
      allow list, write: if false;
    }

    match /showcaseLegalVersions/{version} {
      allow get: if true;
      allow list, write: if false;
    }

    // Economia interna (EvoCoins/EvoCash) -- seção 26 do prompt de economia. Config
    // sempre de leitura só, nunca escrita pelo cliente (nem por superadmin): qualquer
    // ajuste futuro nos valores passa por uma Cloud Function própria (Fase 4+), nunca
    // por escrita direta no Firestore.
    match /economyConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /accountRestrictions/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow write: if false;
    }

    match /communityRestrictions/{restrictionId} {
      // Fase 5: dono da comunidade também pode ver quem está banido dela (mesmo poder
      // de moderação que o superadmin já tinha) -- isCommunityOwner só é avaliada
      // (pagando seu get() extra) quando as duas checagens mais baratas já falharam.
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid)
        || isCommunityOwner(resource.data.communityId);
      // setCommunityMemberBan (Cloud Function) é o único escritor -- nunca o cliente,
      // nem para o próprio superadmin/dono (mesmo padrão de communityRestrictions até
      // aqui: write sempre false, só Admin SDK).
      allow write: if false;
    }

    match /supportRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow write: if false;
    }

    // EvoCash (Fase 4 -- seção 26 do prompt de economia). Top-level, mesmo padrão de
    // supportRequests: dono ou superadmin leem, cliente nunca escreve -- todo o ciclo
    // (requestCashPurchase/confirmCashPurchase/cancelCashPurchase) passa só pela Admin
    // SDK, nunca por escrita direta do Firestore.
    match /cashPurchases/{purchaseId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow write: if false;
    }

    // Administração de chaves PIX (/admin/pagamentos) -- server-only, sem exceção nem
    // para superadmin via client SDK: todo o CRUD (listPixPaymentMethods/
    // savePixPaymentMethod/setActivePixPaymentMethod/deletePixPaymentMethod/
    // setPixPaymentsEnabled) passa só pela Admin SDK. Nunca guarda senha bancária, token
    // ou qualquer credencial de acesso -- só dados de recebimento (chave/tipo/
    // recebedor). A chave ATIVA é republicada em economyConfig/current.pixPayment (essa
    // sim de leitura liberada a qualquer signed-in, ver acima) só com os campos públicos
    // necessários para o comprador pagar.
    match /privatePaymentConfig/{docId} {
      allow read, write: if false;
    }

    // Fase 6 (promoções pagas com EvoCash) -- pacote fixo/duração fixa, completamente
    // separado de sponsoredAds (institucional, superadmin-only, ver match abaixo). O
    // feed nunca lê esta coleção (só os campos denormalizados promoted/promotedUntil em
    // statuses/communities, já cobertos pelas Rules deles) -- só o dono (tela "Minhas
    // promoções") e superadmin (moderação) precisam ler o documento em si. Escrita
    // sempre via Admin SDK (createPromotion/cancelPromotion/recordPromotionEvent) --
    // nunca o cliente, nem os contadores de clique (mesmo padrão de cashPurchases).
    match /promotions/{promotionId} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow write: if false;
    }

    match /moderationDecisions/{decisionId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Vitrine V1: o documento autoritativo nunca é público. Visitantes anônimos leem
    // somente a projeção sanitizada, escrita pela Admin SDK ao publicar (publish() em
    // professional-listing-service.js) -- publicação é direta pelo titular, sem fila
    // de aprovação prévia; moderação acontece depois, pelo canal único de denúncia.
    match /professionalListings/{listingId} {
      allow get: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow write: if false;
    }

    match /professionalListingDrafts/{listingId} {
      allow read: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow write: if false;
    }

    match /professionalListingOwnerLocks/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list, write: if false;
    }

    match /publishedProfessionalListings/{listingId} {
      allow get, list: if resource.data.publicationStatus == 'published';
      allow write: if false;
    }

    match /showcaseReviewDecisions/{decisionId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /showcaseReports/{reportId} {
      allow read: if isSignedIn()
        && (resource.data.reporterId == request.auth.uid || isSuperAdmin());
      allow write: if false;
    }

    match /profileAvatarMedia/{mediaId} {
      allow read: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow write: if false;
    }

    match /showcaseReportRateLimits/{userId} {
      allow read, write: if false;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // Espelho de users/{uid}.communityIds (mantido só pela Admin SDK — ver
    // user-communities-sync.js). Existe unicamente pra sponsoredAds/{adId} poder checar
    // filiação com list.hasAny(list) em vez de iterar communityIds do próprio anúncio,
    // algo que a linguagem de regras não suporta (só permite get()/exists() em caminhos
    // fixos, nunca por elemento de um array armazenado). Chamada como função, não como
    // `let`, pelo mesmo motivo do comentário em emailVerifiedOk() — perto do teto de
    // variáveis por função que já causou incidente (ver hasAppAccess()).
    function myCommunityIds() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('communityIds', []);
    }

    function isValidExercise(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        // Sem teto até aqui — o formulário só oferecia uma lista fixa de grupos, então
        // nada gravava um valor arbitrariamente grande, mas o campo sempre foi texto
        // livre nesta regra. Agora que o formulário deixa criar grupos personalizados
        // (digitar texto de verdade), o mesmo campo passa a receber entrada direta do
        // usuário — precisa do mesmo teto que os demais campos de texto do app.
        && data.muscleGroup is string && data.muscleGroup.size() > 0 && data.muscleGroup.size() <= 30
        && data.active is bool
        // Opcional (não 'in [...]' exigido): exercícios de antes desta mudança não têm
        // esse campo, e não dá pra migrá-los todos de uma vez — ausente é tratado como
        // 'strength' tanto aqui quanto no cliente (ver getExerciseType em
        // workoutSets.js). Imutabilidade depois de criado fica só no cliente (formulário
        // não deixa editar): mudar de 'strength' pra 'cardio' com treinos já registrados
        // só bagunça a visualização do próprio dono, nunca afeta outro usuário nem
        // corrompe dado real — não compensa o custo de separar create/update só pra
        // travar isso aqui também.
        && (!('type' in data) || data.type in ['strength', 'cardio'])
        && (!('note' in data) || data.note is string && data.note.size() <= 300)
        && (!('source' in data) || data.source in ['custom', 'catalog'])
        && (!('catalogExerciseId' in data)
          || data.catalogExerciseId == null
          || data.catalogExerciseId is string
            && data.catalogExerciseId.size() > 0
            && data.catalogExerciseId.size() <= 100)
        && (data.get('source', 'custom') != 'catalog'
          || data.catalogExerciseId is string && data.catalogExerciseId.size() > 0)
        && (data.get('source', 'custom') != 'custom'
          || data.get('catalogExerciseId', null) == null)
        // Posição do exercício dentro do próprio muscleGroup (ver "Reordenar
        // exercícios" em Exercises.jsx) -- opcional pelo mesmo motivo de type/note:
        // a maioria dos exercícios nunca é reordenada manualmente, e um exercício
        // que muda de grupo perde esse valor de propósito (ExercisesContext.edit),
        // caindo no fim do grupo novo até o usuário reordenar de novo.
        && (!('order' in data) || (data.order is int && data.order >= 0 && data.order < 300));
    }

    function validSet(set) {
      let weight = set.weight;
      let reps = set.reps;
      return set.keys().hasOnly(['weight', 'reps'])
        && weight is number && weight >= 0 && weight <= 10000
        && reps is int && reps > 0 && reps <= 100000;
    }

    function validSetAt(sets, index) {
      return sets.size() <= index || validSet(sets[index]);
    }

    // Sessão de cardio (corrida etc.) — duração obrigatória, distância opcional. Sem
    // "séries", por isso um ramo de validação totalmente separado do de força abaixo.
    function isValidCardioSession(data) {
      return data.durationMinutes is number && data.durationMinutes > 0 && data.durationMinutes <= 600
        && (!('distanceKm' in data)
          || (data.distanceKm is number && data.distanceKm > 0 && data.distanceKm <= 500));
    }

    // Rules cannot iterate lists. Validate all positions up to MAX_WORKOUT_SETS (10).
    // data.get('type', 'strength') no ramo de força cobre tanto o registro explícito
    // quanto os de antes desta mudança (sem o campo) — só cardio precisa do campo
    // explícito, já que não existe treino de cardio legado. O campo, uma vez gravado,
    // não muda: a checagem de imutabilidade fica no allow update abaixo (mesma
    // comparação com default, pra não quebrar registros antigos sem o campo).
    function isValidWorkout(data) {
      let sets = data.setDetails;
      return data.exerciseId is string && data.exerciseId.size() > 0
        && data.date is timestamp
        && (!('note' in data) || data.note is string && data.note.size() <= 300)
        && (
          (data.get('type', 'strength') == 'strength'
            && data.keys().hasOnly(['exerciseId', 'setDetails', 'sets', 'date', 'note', 'createdAt', 'type'])
            && data.setDetails is list && data.setDetails.size() > 0 && data.setDetails.size() <= 10
            && data.sets is int && data.sets == data.setDetails.size()
            && validSetAt(sets, 0)
            && validSetAt(sets, 1)
            && validSetAt(sets, 2)
            && validSetAt(sets, 3)
            && validSetAt(sets, 4)
            && validSetAt(sets, 5)
            && validSetAt(sets, 6)
            && validSetAt(sets, 7)
            && validSetAt(sets, 8)
            && validSetAt(sets, 9))
          || (data.type == 'cardio'
            && data.keys().hasOnly(['exerciseId', 'type', 'durationMinutes', 'distanceKm', 'date', 'note', 'createdAt'])
            && isValidCardioSession(data))
        );
    }

    function isValidUsernameField(data) {
      return !('username' in data) || data.username == null
        || (data.username is string && data.username.matches('^[a-z0-9_]{3,20}$'));
    }

    // A reserva em /usernames/{username} (uid do dono) é a fonte da verdade da
    // exclusividade do @ — o cliente normalmente a respeita dentro de uma transação
    // (setUsername/updateUserProfile em usersService.js), mas isso é só convenção: nada
    // impedia uma escrita direta em users/publicProfiles/statuses com um @ que aponta
    // para outra conta (ou para nenhuma reserva), permitindo personificação visual no
    // perfil público e nas publicações. Sem isso, o servidor nunca validava o vínculo.
    function usernameIsReservedBy(userId, username) {
      let ref = /databases/$(database)/documents/usernames/$(username);
      return exists(ref) && get(ref).data.uid == userId;
    }

    function ownsUsernameField(userId, data) {
      return !('username' in data) || data.username == null
        || usernameIsReservedBy(userId, data.username);
    }

    // AUD-010: a troca de um @ já existente por outro precisa acontecer inteira numa
    // única transação (ver renameUsername em functions/index.js) -- reservar
    // usernames/{novo} e só depois atualizar users/publicProfiles em escritas
    // separadas é exatamente a falha original (rede caindo entre as duas deixava o
    // novo @ reservado sem dono). ownsUsernameField() sozinha não bastava: ela só
    // confere que a posse do valor NOVO é legítima, nunca impede a troca em si de
    // acontecer fora de uma transação. Esta função isola a única transição que o
    // cliente ainda pode fazer direto: sair de "sem @" (username ausente/null, o
    // estado inicial gravado por ensureUserProfile) para um @ com reserva própria --
    // é exatamente o que Register.jsx faz uma única vez, não existe caminho de troca
    // aqui. Uma vez com @ definido, qualquer mudança (inclusive zerar o campo) só
    // passa pela Cloud Function, que ignora estas regras via Admin SDK.
    function isInitialUsernameClaim(userId, before, after) {
      return before.get('username', null) == null
        && ownsUsernameField(userId, after);
    }

    function isValidBioField(data) {
      return !('bio' in data) || data.bio == null
        || (data.bio is string && data.bio.size() <= 300);
    }

    function isValidSexoField(data) {
      return !('sexo' in data) || data.sexo == null
        || data.sexo in ['masculino', 'feminino', 'nao_informar'];
    }

    // A idade mínima em si (manifest.minimumAge) é conferida pela Cloud Function
    // acceptLegalDocuments, a única que conhece o valor atual do manifesto legal — aqui
    // só se garante o formato: um timestamp plausível, nunca no futuro nem
    // implausivelmente antigo (mais de 120 anos), igual à validação client-side em
    // src/utils/validators.js (validateBirthDate), nunca confiando só nela.
    function isValidBirthDateField(data) {
      return !('dataNascimento' in data) || data.dataNascimento == null
        || (data.dataNascimento is timestamp
          && data.dataNascimento <= request.time
          && data.dataNascimento > request.time - duration.value(120 * 365, 'd'));
    }

    // Altura muda raramente (diferente de peso/%gordura, que têm histórico próprio em
    // bodyMeasurements) — fica como campo único no perfil, mesmo padrão de sexo/
    // dataNascimento: opcional, nulo pra limpar, faixa plausível quando presente.
    function isValidHeightField(data) {
      return !('heightCm' in data) || data.heightCm == null
        || (data.heightCm is number && data.heightCm >= 50 && data.heightCm <= 250);
    }

    // Documento público separado: nunca liberar leitura do perfil privado para visitantes.
    match /publicProfiles/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['username', 'bio', 'shareStatistics'])
        && request.resource.data.keys().hasOnly(['username', 'bio', 'shareStatistics', 'avatarMediaId', 'avatarPath', 'updatedAt'])
        && !('avatarMediaId' in request.resource.data)
        && !('avatarPath' in request.resource.data)
        && !('updatedAt' in request.resource.data)
        && isValidUsernameField(request.resource.data)
        && ownsUsernameField(userId, request.resource.data)
        && isValidBioField(request.resource.data)
        && request.resource.data.shareStatistics is bool;
      // AUD-010: só dois casos de @ são aceitos direto do cliente -- sem mudança
      // nenhuma, ou a primeira reivindicação (username ainda ausente/null neste
      // documento, ver isInitialUsernameClaim). Qualquer troca de um @ já definido
      // por outro (inclusive zerar) é rejeitada aqui e só acontece via a Cloud
      // Function renameUsername, atômica, Admin SDK.
      allow update: if isOwner(userId)
        && request.resource.data.keys().hasAll(['username', 'bio', 'shareStatistics'])
        && request.resource.data.keys().hasOnly(['username', 'bio', 'shareStatistics', 'avatarMediaId', 'avatarPath', 'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['username', 'bio', 'shareStatistics'])
        && isValidUsernameField(request.resource.data)
        && (request.resource.data.get('username', null) == resource.data.get('username', null)
          || isInitialUsernameClaim(userId, resource.data, request.resource.data))
        && isValidBioField(request.resource.data)
        && request.resource.data.shareStatistics is bool;
      // Só permite ao próprio usuário apagar o perfil nos minutos seguintes à criação —
      // nunca é uma forma geral de "excluir minha conta" (isso sempre passa por
      // deleteAccountPermanently, com job de exclusão auditável). Existe só para desfazer
      // um cadastro que falhou depois de criar o documento (ver setUsername em
      // Register.jsx): sem isso, uma falha de rede bem depois de ensureUserProfile()
      // deixava o perfil órfão no Firestore pra sempre, mesmo com a conta do
      // Authentication já desfeita.
      allow delete: if isOwner(userId)
        && get(/databases/$(database)/documents/users/$(userId)).data.createdAt is timestamp
        && request.time < get(/databases/$(database)/documents/users/$(userId)).data.createdAt + duration.value(10, 'm');

      match /statistics/{summaryId} {
        allow get: if isSignedIn()
          && get(/databases/$(database)/documents/publicProfiles/$(userId)).data.shareStatistics == true;
        allow list: if false;
        // AUD-006: create/update só pela Cloud Function refreshPublicStatistics
        // (functions/index.js), via Admin SDK — o valor precisa vir de uma agregação
        // real sobre users/{uid}/workouts, e regras não têm como conferir isso contra
        // o diário do próprio usuário sem reler a coleção inteira (inviável no custo
        // de uma avaliação de regra). Antes disso, qualquer client-side conseguia
        // forjar entries/sets com qualquer número não negativo. delete continua do
        // dono: apagar o próprio resumo é sempre seguro.
        allow create, update: if false;
        allow delete: if isOwner(userId);
      }
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      // Perfil sempre nasce como "user"; virar superadmin exige edição manual
      // (console/Admin SDK), nunca uma escrita vinda do cliente.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.keys().hasOnly(['role', 'createdAt', 'username', 'bio', 'shareStatistics', 'publicProfileVersion', 'sexo', 'dataNascimento', 'heightCm'])
        && request.resource.data.createdAt == request.time
        && isValidUsernameField(request.resource.data)
        && ownsUsernameField(userId, request.resource.data)
        && isValidBioField(request.resource.data)
        && isValidSexoField(request.resource.data)
        && isValidBirthDateField(request.resource.data)
        && isValidHeightField(request.resource.data);
      // sexo/dataNascimento entram aqui (não só no create) porque Register.jsx grava os
      // dois com um merge separado, logo depois de ensureUserProfile() já ter criado o
      // documento — na prática, sempre um update (ver setBirthInfo em usersService.js).
      // AUD-010: mesmo raciocínio de publicProfiles acima -- só a primeira reivindicação
      // do @ (isInitialUsernameClaim) passa direto; qualquer troca de um @ já existente
      // exige a Cloud Function renameUsername.
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['username', 'bio', 'shareStatistics', 'publicProfileVersion', 'sexo', 'dataNascimento', 'heightCm'])
        && isValidUsernameField(request.resource.data)
        && (request.resource.data.get('username', null) == resource.data.get('username', null)
          || isInitialUsernameClaim(userId, resource.data, request.resource.data))
        && isValidBioField(request.resource.data)
        && isValidSexoField(request.resource.data)
        && isValidBirthDateField(request.resource.data)
        && isValidHeightField(request.resource.data);
      // Mesma janela e mesmo motivo de publicProfiles acima: só para desfazer um
      // cadastro recém-criado que falhou depois deste documento existir.
      allow delete: if isOwner(userId)
        && resource.data.createdAt is timestamp
        && request.time < resource.data.createdAt + duration.value(10, 'm');

      match /exercises/{exerciseId} {
        allow read, delete: if isOwner(userId) && hasAppAccess(isSuperAdmin());
        allow create, update: if isOwner(userId) && hasAppAccess(isSuperAdmin()) && isValidExercise(request.resource.data);
      }

      match /workouts/{workoutId} {
        allow read, delete: if isOwner(userId) && hasAppAccess(isSuperAdmin());
        // createdAt desempata registros do mesmo dia (o usuário escolhe só a data, não a
        // hora) na ordenação "mais recente primeiro" — sem isso, dois treinos no mesmo
        // dia ficam em ordem arbitrária (critério interno do Firestore, não a ordem real
        // de criação), o que já produziu "evolução" e gráfico invertidos na prática.
        // Exigido e travado como request.time na criação, e imutável na edição — igual
        // ao padrão já usado em statuses/supportRequests.
        allow create: if isOwner(userId) && hasAppAccess(isSuperAdmin()) && isValidWorkout(request.resource.data)
          && request.resource.data.createdAt == request.time;
        // type também travado na edição, mesmo padrão do createdAt acima (default
        // 'strength' dos dois lados, pra não quebrar registros de antes deste campo
        // existir) — mudar o formato de um treino já existente (força vira cardio ou
        // vice-versa) deixaria o documento sem as séries/duração que a nova forma exige.
        allow update: if isOwner(userId) && hasAppAccess(isSuperAdmin()) && isValidWorkout(request.resource.data)
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && request.resource.data.get('type', 'strength') == resource.data.get('type', 'strength');
      }

      // App não tem balança de bioimpedância — cada campo é um input manual opcional,
      // sempre um documento novo por check-in (nunca sobrescreve o anterior), pra dar
      // pra calcular tendência depois (ver bodyComposition.js, calculado no cliente
      // sobre uma janela limitada, não aqui). Pelo menos um dos campos de medida real
      // precisa estar presente — um check-in inteiramente vazio não serve pra nada.
      function isValidBodyMeasurement(data) {
        return data.keys().hasOnly([
            'date', 'weightKg', 'bodyFatPercent', 'abdomenCm', 'waistCm', 'hipCm',
            'chestCm', 'armCm', 'thighCm', 'calfCm', 'leanMassKg', 'fatMassKg',
            'note', 'createdAt'
          ])
          && data.date is timestamp
          && (!('weightKg' in data) || (data.weightKg is number && data.weightKg > 0 && data.weightKg <= 400))
          && (!('bodyFatPercent' in data) || (data.bodyFatPercent is number && data.bodyFatPercent > 0 && data.bodyFatPercent <= 70))
          && (!('abdomenCm' in data) || (data.abdomenCm is number && data.abdomenCm > 0 && data.abdomenCm <= 300))
          && (!('waistCm' in data) || (data.waistCm is number && data.waistCm > 0 && data.waistCm <= 200))
          && (!('hipCm' in data) || (data.hipCm is number && data.hipCm > 0 && data.hipCm <= 200))
          && (!('chestCm' in data) || (data.chestCm is number && data.chestCm > 0 && data.chestCm <= 300))
          && (!('armCm' in data) || (data.armCm is number && data.armCm > 0 && data.armCm <= 200))
          && (!('thighCm' in data) || (data.thighCm is number && data.thighCm > 0 && data.thighCm <= 200))
          && (!('calfCm' in data) || (data.calfCm is number && data.calfCm > 0 && data.calfCm <= 200))
          && (!('leanMassKg' in data) || (data.leanMassKg is number && data.leanMassKg > 0 && data.leanMassKg <= 300))
          && (!('fatMassKg' in data) || (data.fatMassKg is number && data.fatMassKg > 0 && data.fatMassKg <= 300))
          && (!('note' in data) || (data.note is string && data.note.size() <= 300))
          && ('weightKg' in data || 'bodyFatPercent' in data || 'waistCm' in data
            || 'hipCm' in data || 'leanMassKg' in data || 'abdomenCm' in data
            || 'chestCm' in data || 'armCm' in data || 'thighCm' in data
            || 'calfCm' in data || 'fatMassKg' in data);
      }

      // Resumo derivado dos treinos pela Cloud Function onWorkoutWritten. O cliente
      // pode consultar o próprio progresso, mas nunca forjar ou editar totais.
      match /progressDaily/{day} {
        allow read: if isOwner(userId) && hasAppAccess(isSuperAdmin());
        allow write: if false;
      }

      match /bodyMeasurements/{measurementId} {
        allow read, delete: if isOwner(userId) && hasAppAccess(isSuperAdmin());
        allow create: if isOwner(userId) && hasAppAccess(isSuperAdmin()) && isValidBodyMeasurement(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(userId) && hasAppAccess(isSuperAdmin()) && isValidBodyMeasurement(request.resource.data)
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
      }

      match /legalAcceptances/{version} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if false;
      }

      match /showcaseLegalAcceptances/{version} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if false;
      }

      match /notices/{noticeId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if false;
      }

      // Economia interna (EvoCoins/EvoCash) -- seção 5/6/26 do prompt de economia.
      // Mesmo padrão de leitura de legalAcceptances/notices acima (dono ou superadmin,
      // sem exigir hasAppAccess): mesmo uma conta desativada/suspensa continua
      // enxergando o próprio saldo/histórico -- só a Cloud Function decide se ela pode
      // GANHAR ou GASTAR algo, nunca se pode LER. Cliente nunca escreve nenhum dos três:
      // saldo, ledger e o resumo diário são sempre calculados e gravados pela Admin SDK.
      match /wallet/{docId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if false;
      }

      match /economyTransactions/{transactionId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if false;
      }

      match /economyDaily/{day} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if false;
      }
    }

    // Reserva de @usuário: um documento por nome de usuário, apontando para o dono.
    // Impede duplicidade (dois usuários com o mesmo @) sem precisar de Cloud Function —
    // o cliente sempre lê aqui dentro de uma transação antes de reivindicar um nome.
    match /usernames/{username} {
      // Leitura pública: o cadastro precisa checar disponibilidade do @ antes de criar
      // a conta no Authentication (usuário ainda não está autenticado nesse momento).
      // O documento só expõe uid + createdAt, então não há dado sensível aqui.
      allow read: if true;
      // AUD-010: reservar um @ novo direto do cliente só é aceito enquanto o próprio
      // usuário ainda não tem username nenhum em users/{uid} -- é exatamente a janela
      // do cadastro inicial (ensureUserProfile cria o perfil com username: null antes
      // de Register.jsx chamar setUsername). Quem já tem @ não consegue mais reservar
      // um nome novo por aqui: mesmo que reservasse, a atualização de
      // users/publicProfiles pra usá-lo já é bloqueada (ver isInitialUsernameClaim),
      // então isto fecha a reserva "solta" também, não só o passo seguinte.
      allow create: if isSignedIn()
        && username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', null) == null;
      // Mesma janela de 10 minutos que users/{userId} e publicProfiles/{userId} (ver
      // deleteFreshProfile em src/services/usersService.js) -- sem ela, o dono podia
      // liberar a própria reserva a qualquer momento da vida da conta enquanto
      // users/publicProfiles ainda apontavam pro mesmo @ (não são apagados junto),
      // abrindo uma janela para outra conta reivindicar o MESMO nome de usuário já
      // exibido em outro lugar (duas contas com o mesmo @, inclusive em publicações
      // futuras). Fora do cadastro, a única forma de mudar de @ é renameUsername
      // (Admin SDK), que já cuida de tudo numa transação só.
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.createdAt is timestamp
        && request.time < resource.data.createdAt + duration.value(10, 'm');
      allow update: if false;
    }

    function isValidCommunity(data) {
      return data.keys().hasOnly([
          'name', 'description', 'imageUrl', 'iconName', 'isActive', 'postAccess',
          'memberCount', 'createdBy', 'createdAt', 'ownerId', 'promoted', 'promotedUntil',
          'activePromotionId'
        ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && data.description is string && data.description.size() <= 300
        // imageUrl é somente compatibilidade de leitura com comunidades antigas; o
        // formulário atual não envia a chave. Acessá-la diretamente quando ausente
        // causa erro de avaliação e nega até o payload válido do createCommunity().
        && (!('imageUrl' in data) || data.imageUrl == null || data.imageUrl is string)
        && data.isActive is bool
        && data.createdBy is string
        && data.createdAt is timestamp
        // Fase 5: fonte autoritativa de permissão dentro da comunidade (ver
        // isCommunityOwner) -- sempre igual a createdBy na criação (nenhuma
        // transferência de posse existe ainda), mas é um campo PRÓPRIO e imutável
        // separado, não um alias de createdBy, porque uma futura transferência de posse
        // mudaria só este campo, nunca o registro histórico de quem criou. Ausente =
        // comunidade de antes deste campo existir (só superadmin administra -- ver
        // isCommunityOwner/allow update abaixo, nunca tratado como "qualquer uid é
        // dono"). Opcional de propósito, mesmo padrão de postAccess/iconName logo
        // abaixo: uma comunidade antiga sem backfill continua editável pelo superadmin
        // sem migração obrigatória (ver auditoria de compatibilidade da Fase 5).
        && (!('ownerId' in data) || data.ownerId is string)
        // Ausente = 'everyone' (comunidades criadas antes deste campo existir continuam
        // válidas sem precisar de migração).
        && (!('postAccess' in data) || data.postAccess in ['everyone', 'admins'])
        // memberCount é mantido pela Cloud Function (gatilho em communityMembers) e,
        // como fallback de leitura, recalculado e regravado pelo próprio painel admin
        // quando ainda não existe — nunca gravado pelo cliente com valor arbitrário
        // além de refletir uma contagem real já lida do servidor.
        && (!('memberCount' in data) || (data.memberCount is int && data.memberCount >= 0))
        // Ausente = ícone padrão na leitura (getCommunityIcon em communityIcons.js, sem
        // precisar migrar comunidades antigas) — mas nunca aceita string arbitrária do
        // cliente aqui: só um dos nomes da grade do seletor. Lista espelhada manualmente
        // de COMMUNITY_ICON_NAMES em src/constants/communityIcons.js (regras não importam
        // JS) — mudar um lado exige mudar o outro.
        && (!('iconName' in data) || data.iconName in [
          'users', 'dumbbell', 'heart-pulse', 'flame', 'trophy', 'target',
          'zap', 'star', 'rocket', 'mountain', 'bike', 'footprints'
        ])
        // Fase 6 (promoções pagas com EvoCash): denormalizado por createPromotion/
        // cancelPromotion (Admin SDK, ignora esta Rule inteira) -- só aparece aqui pra
        // que o formato continue válido quando o cliente reenvia o documento inteiro
        // numa edição comum (ex.: trocar a descrição). A imutabilidade de verdade
        // (cliente nunca MUDA o valor) está no allow update abaixo, não aqui.
        && (!('promoted' in data) || data.promoted is bool)
        && (!('promotedUntil' in data) || data.promotedUntil == null || data.promotedUntil is timestamp)
        // activePromotionId: mesmo raciocínio -- só createPromotion/cancelPromotion
        // (Admin SDK) gravam, aparece aqui só pra validar o formato quando o cliente
        // reenvia o documento inteiro numa edição comum. Nunca a promotions/{id}
        // correspondente é exposta ao cliente por este campo sozinho (ver
        // recordPromotionEvent, que revalida tudo de novo no servidor).
        && (!('activePromotionId' in data) || data.activePromotionId == null || data.activePromotionId is string);
    }

    function communityIsActive(communityId) {
      return get(/databases/$(database)/documents/communities/$(communityId)).data.isActive == true;
    }

    // Fase 5 (privilégios): dono de UMA comunidade específica -- escopo estritamente
    // menor que isSuperAdmin(), nunca um substituto dele. communities.ownerId é a única
    // fonte autoritativa (nunca o role de communityMembers, que é só para UI). Custa 1
    // get() extra sempre que chamada -- usada só onde o documento sendo avaliado não é
    // já o próprio community doc (para a Rule de update de communities, ler
    // resource.data.ownerId direto é de graça, sem chamar esta função).
    function isCommunityOwner(communityId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/communities/$(communityId)).data.get('ownerId', null) == request.auth.uid;
    }

    match /communities/{communityId} {
      allow read: if hasAppAccess(isSuperAdmin());
      // ownerId opcional na criação de propósito: uma comunidade OFICIAL criada
      // direto pelo superadmin (este caminho -- createCommunityWithCash nunca passa
      // por aqui, é Admin SDK) prefere nascer SEM ownerId, administrada globalmente
      // por isSuperAdmin() para sempre. Se este campo fosse gravado com o uid de quem
      // criou, uma conta que mais tarde perdesse role:'superadmin' continuaria "dona"
      // daquela comunidade oficial só por tê-la criado no passado -- exatamente o que
      // isValidCommunity() não pode permitir. Quando presente, ainda precisa ser o
      // próprio uid de quem cria (nunca atribuído a outra pessoa nesta Rule).
      allow create: if isSuperAdmin()
        && isValidCommunity(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && (!('ownerId' in request.resource.data) || request.resource.data.ownerId == request.auth.uid);
      // Fase 5: dono da própria comunidade tem os mesmos poderes de edição/desativação
      // que o superadmin tinha sozinho -- resource.data.ownerId já está em mãos aqui
      // (é o próprio documento sendo atualizado), então isto não soma nenhum get() novo.
      // ownerId nunca muda depois de criado (mesma imutabilidade de createdBy/createdAt)
      // -- Fase 5 não inclui transferência de posse.
      allow update: if (isSuperAdmin() || resource.data.get('ownerId', null) == request.auth.uid)
        && !exists(/databases/$(database)/documents/deletionJobs/$('community_' + communityId))
        && isValidCommunity(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        // .get(..., null) dos dois lados -- nunca acesso direto: uma comunidade
        // antiga sem ownerId não tem esse campo nem em resource.data nem (por não ser
        // enviado por updateCommunity()) em request.resource.data, e comparar campos
        // ausentes diretamente (em vez de via .get) lança erro de avaliação em vez de
        // simplesmente reprovar -- o que travaria toda edição de comunidade antiga.
        && request.resource.data.get('ownerId', null) == resource.data.get('ownerId', null)
        // Fase 6: promoted/promotedUntil são server-managed (só createPromotion/
        // cancelPromotion, Admin SDK, gravam) -- nem o dono nem o superadmin conseguem
        // mudá-los por uma edição comum do cliente, mesma imutabilidade já aplicada a
        // createdBy/createdAt/ownerId acima.
        && request.resource.data.get('promoted', false) == resource.data.get('promoted', false)
        && request.resource.data.get('promotedUntil', null) == resource.data.get('promotedUntil', null)
        && request.resource.data.get('activePromotionId', null) == resource.data.get('activePromotionId', null);
      allow delete: if false;
    }

    function expectedMembershipId(data) {
      return data.communityId + '_' + data.userId;
    }

    match /communityMembers/{membershipId} {
      // Leitura restrita: cada usuário só enxerga a própria filiação; superadmin ou o
      // dono da comunidade (Fase 5) podem listar/contar todos os membros dela.
      // resource == null cobre o get() de "ainda não sou membro" (documento não
      // existe): sem isso, resource.data.userId falha a avaliação e o Firestore
      // nega com permission-denied em vez de simplesmente não encontrar nada. O curto-
      // circuito de || garante que isCommunityOwner só é avaliada (e paga seu get()
      // extra) quando as checagens mais baratas acima já falharam.
      allow read: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid || isSuperAdmin()
          || isCommunityOwner(resource.data.communityId));
      allow create: if hasAppAccess(isSuperAdmin())
        && request.resource.data.userId == request.auth.uid
        && membershipId == expectedMembershipId(request.resource.data)
        && request.resource.data.joinedAt is timestamp
        && communityIsActive(request.resource.data.communityId)
        && communityAccessAllowed(request.resource.data.communityId);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // isAdmin como parâmetro (em vez de chamar isSuperAdmin() aqui dentro) porque quem
    // usa isMember() para criar/validar uma publicação (match /statuses abaixo) também
    // precisa do mesmo isAdmin em communityAllowsPosting()/isValidStatusBase() — calcular
    // uma vez só no ponto de entrada e repassar evita reler users/{uid} várias vezes na
    // mesma avaliação (é exatamente essa repetição que já estourou o limite de expressões
    // do Firestore em produção; ver o comentário em hasAppAccess()).
    function isMember(communityId, isAdmin) {
      return hasAppAccess(isAdmin) && communityAccessAllowed(communityId)
        && exists(/databases/$(database)/documents/communityMembers/$(communityId + '_' + request.auth.uid));
    }

    // Cada opção precisa ser {id, label}, do mesmo jeito que o cliente sempre monta
    // (ver createPollStatus em statusesService.js) — sem isso, um item malformado
    // (ex.: null) passava na regra e quebrava a renderização da enquete no cliente
    // (PollStatus acessa option.id/option.label direto). Mesmo padrão de
    // "validar até um índice máximo fixo" já usado para setDetails (validSetAt acima).
    function isValidPollOption(option) {
      return option.id is string && option.id.size() > 0 && option.id.size() <= 20
        && option.label is string && option.label.size() > 0 && option.label.size() <= 80;
    }
    function validPollOptionAt(options, index) {
      return options.size() <= index || isValidPollOption(options[index]);
    }

    // AUD-005: cada branch abaixo trava as chaves de NÍVEL SUPERIOR do documento
    // (identidade + o único campo de conteúdo daquele tipo), além do formato do
    // conteúdo em si já validado linha a linha. keys().hasOnly() não custa nenhuma
    // leitura extra (não é get()/exists()), então não entra no teto de expressões
    // por avaliação de regra documentado nos comentários de canCreateStatus() acima —
    // só a validação de formato (poll.options[i], achievement.*) tinha esse cuidado
    // até aqui; campos inteiros fora do esquema esperado (ex.: um "poll" pendurado
    // numa publicação type == 'text') não eram rejeitados antes desta mudança.
    function statusBaseKeys() {
      return ['communityId', 'authorId', 'authorUsername', 'authorIsSuperAdmin', 'type', 'createdAt', 'expiresAt'];
    }

    function isValidStatusContent(data, statusId) {
      return (data.type == 'text' &&
          data.keys().hasOnly(statusBaseKeys().concat(['text']))
          && data.text is string && data.text.size() > 0 && data.text.size() <= 500)
        || (data.type == 'poll' &&
          data.keys().hasOnly(statusBaseKeys().concat(['poll']))
          && data.poll.question is string && data.poll.question.size() > 0 && data.poll.question.size() <= 200
          && data.poll.options is list && data.poll.options.size() >= 2 && data.poll.options.size() <= 6
          && validPollOptionAt(data.poll.options, 0)
          && validPollOptionAt(data.poll.options, 1)
          && validPollOptionAt(data.poll.options, 2)
          && validPollOptionAt(data.poll.options, 3)
          && validPollOptionAt(data.poll.options, 4)
          && validPollOptionAt(data.poll.options, 5))
        || (data.type == 'workout' &&
          data.keys().hasOnly(statusBaseKeys().concat(['workout']))
          && data.workout.title is string && data.workout.title.size() > 0 && data.workout.title.size() <= 100
          && data.workout.date is timestamp
          && data.workout.location is string && data.workout.location.size() <= 150)
        || (data.type == 'achievement' &&
          data.keys().hasOnly(statusBaseKeys().concat(['achievement']))
          && data.achievement.keys().hasOnly(['day', 'text', 'entries', 'sets'])
          && data.achievement.day is string
          // Mês 01-12 e dia 01-31 (sem checar dias por mês/ano bissexto — regras não
          // fazem aritmética de calendário; isso já barra valores impossíveis como
          // mês 13 ou dia 40, que o formato antigo aceitava).
          && data.achievement.day.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && data.achievement.text is string && data.achievement.text.size() <= 300
          && data.achievement.entries is int && data.achievement.entries >= 0
          && data.achievement.sets is number && data.achievement.sets >= 0
          && (data.achievement.entries > 0 || data.achievement.text.size() > 0))
        // photoPath precisa ser EXATAMENTE statusPhotos/{communityId}/{statusId}.webp —
        // o próprio id deste documento, nunca o de outra publicação. Antes disso, o
        // padrão só exigia "20 caracteres alfanuméricos" sem comparar com statusId: uma
        // publicação podia apontar photoPath para a foto de outra publicação da mesma
        // comunidade e, ao ser excluída, a limpeza (deletion-service.js) apagava do
        // Storage o arquivo que ainda pertencia à publicação alheia, ainda existente.
        || (data.type == 'photo' &&
          data.keys().hasOnly(statusBaseKeys().concat(['photoPath', 'caption']))
          && data.photoPath is string
          && data.photoPath == 'statusPhotos/' + data.communityId + '/' + statusId + '.webp'
          && (!('caption' in data) || (data.caption is string && data.caption.size() <= 280)));
    }

    // Nenhuma chamada a hasAppAccess()/isMember() aqui dentro — cada uma delas
    // re-executaria get()/exists() em documentos que esta função já leu. Essa pilha de
    // chamadas independentes (cada camada relendo os mesmos documentos) foi o que
    // estourou o limite de expressões do Firestore em produção assim que os termos
    // ficaram publicados (confirmado reproduzindo no emulador com
    // legalPolicy/current.published = true — o cenário que nenhum teste anterior
    // cobria). Dividida em duas funções (em vez de uma só) porque o Firestore também
    // limita a no máximo 10 variáveis "let" por função.
    // me: dados de users/{uid} já lidos por quem chamou (canCreateStatus), pra não gastar
    // outra leitura pedindo de novo o mesmo documento. Também por isso a checagem de
    // "conta em exclusão" aqui não é !exists(deletionJobs/account_{uid}) (como em
    // isSignedIn()) — seria mais um documento distinto lido, e o Firestore limita o total
    // de chamadas get()/exists() por avaliação (confirmado no emulador: com os quatro
    // documentos de statusCommunityOk mais os daqui, o total passava do limite e toda
    // criação de publicação era negada). queue() em deletion-service.js grava
    // accountStatus: 'deleting' na MESMA transação que cria o job de exclusão, então o
    // campo que já está em `me` é equivalente e não custa uma leitura a mais.
    function statusAccountOk(uid, me, isAdmin) {
      let policyRef = /databases/$(database)/documents/legalPolicy/current;
      let policyExists = exists(policyRef);
      let policy = policyExists ? get(policyRef).data : {};
      let restrictionRef = /databases/$(database)/documents/accountRestrictions/$(uid);
      let restrictionExists = exists(restrictionRef);
      return me.get('accountStatus', 'active') != 'deleting'
        && (!policyExists || policy.published != true
          || (me.legalAcceptance.version == policy.version && me.legalAcceptance.digest == policy.digest))
        && (isAdmin || me.get('accountStatus', 'active') != 'disabled')
        && (isAdmin || emailVerifiedOk(me))
        && (!restrictionExists
          || (get(restrictionRef).data.action == 'temporary_suspension'
            && get(restrictionRef).data.until <= request.time));
    }

    function statusCommunityOk(uid, communityId, isAdmin) {
      let community = get(/databases/$(database)/documents/communities/$(communityId)).data;
      return !exists(/databases/$(database)/documents/deletionJobs/$('community_' + communityId))
        && !exists(/databases/$(database)/documents/communityRestrictions/$(communityId + '_' + uid))
        && exists(/databases/$(database)/documents/communityMembers/$(communityId + '_' + uid))
        && community.isActive == true
        // Fase 5: o dono da comunidade também conta como "admin" para o próprio
        // postAccess:'admins' dela -- usa o `community` já lido acima (sem get() extra),
        // e NUNCA reescreve o parâmetro isAdmin em si (que continua vindo só de
        // role=='superadmin' e segue gating statusAccountOk isoladamente -- ver
        // canCreateStatus abaixo; misturar os dois deixaria um dono desativado/sem
        // e-mail verificado escapando de checagens que nada têm a ver com esta
        // comunidade).
        && (community.get('postAccess', 'everyone') != 'admins' || isAdmin || community.get('ownerId', null) == uid);
    }

    function canCreateStatus(data, statusId) {
      let uid = request.auth.uid;
      let me = get(/databases/$(database)/documents/users/$(uid)).data;
      let isAdmin = me.get('role', 'user') == 'superadmin';
      let usernameOk = data.authorUsername == null
        || (exists(/databases/$(database)/documents/usernames/$(data.authorUsername))
          && get(/databases/$(database)/documents/usernames/$(data.authorUsername)).data.uid == data.authorId);
      return request.auth != null
        && data.authorId == uid
        && statusAccountOk(uid, me, isAdmin)
        && statusCommunityOk(uid, data.communityId, isAdmin)
        && usernameOk
        && data.communityId is string && data.communityId.size() > 0
        && data.authorId is string
        && data.type in ['text', 'poll', 'workout', 'achievement', 'photo']
        && data.createdAt == request.time
        && data.expiresAt > request.time + duration.value(1435, 'm')
        && data.expiresAt < request.time + duration.value(1445, 'm')
        && data.authorIsSuperAdmin == isAdmin
        && isValidStatusContent(data, statusId);
    }

    // AUD-011: optionId só era validado como string, nunca conferido contra as opções
    // reais da enquete — um cliente podia gravar qualquer valor arbitrário, gerando
    // votos que nunca aparecem na contagem (getPollResults filtra por optionId
    // conhecido) mas seguem contando como "voto existente" pra impedir o usuário de
    // votar de novo. Mesmo padrão de validPollOptionAt (índice fixo até 6, o teto já
    // imposto na criação da enquete): sem custo de leitura extra, já que status já foi
    // lido acima.
    function pollOptionExists(options, optionId) {
      return (options.size() > 0 && options[0].id == optionId)
        || (options.size() > 1 && options[1].id == optionId)
        || (options.size() > 2 && options[2].id == optionId)
        || (options.size() > 3 && options[3].id == optionId)
        || (options.size() > 4 && options[4].id == optionId)
        || (options.size() > 5 && options[5].id == optionId);
    }

    // Mesma ideia para votes/participants: cada documento (status pai + users/{uid} para
    // saber se sou admin) lido uma única vez, em vez de isMember()/isSuperAdmin() cada
    // uma relendo por conta própria.
    function canVote(statusId, userId, voteData) {
      let status = get(/databases/$(database)/documents/statuses/$(statusId)).data;
      let uid = request.auth.uid;
      let isAdmin = get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'user') == 'superadmin';
      return isSignedIn()
        && userId == uid
        && voteData.keys().hasOnly(['userId', 'optionId', 'createdAt'])
        && voteData.userId == uid
        && voteData.optionId is string
        && voteData.createdAt is timestamp
        && status.type == 'poll'
        && pollOptionExists(status.poll.options, voteData.optionId)
        && (status.expiresAt > request.time
          || (status.get('promoted', false) == true
            && status.get('promotedUntil', null) is timestamp
            && status.promotedUntil > request.time))
        && isMember(status.communityId, isAdmin);
    }

    // Treino Marcado V1: a elegibilidade para participar é a DATA DO EVENTO
    // (status.workout.date), nunca status.expiresAt (o prazo de 24h que só controla
    // quanto tempo o post fica no feed recente, igual a qualquer outro tipo -- ver
    // listCommunityFeed em statusesService.js e canCreateStatus acima, que continuam
    // intocados). Antes desta mudança, um treino marcado para daqui a vários dias
    // ficava impossível de confirmar presença assim que o POST completasse 24h, bem
    // antes do evento em si acontecer -- e nada impedia entrar num treino cuja data já
    // tinha passado. status.workout.date > request.time resolve as duas coisas de uma
    // vez: bloqueia join após o evento, e libera join enquanto o evento ainda não
    // aconteceu, mesmo que o post já tenha saído do feed recente (ver a seção "Próximos
    // treinos", que busca por workout.date > agora, não por expiresAt).
    function canJoinWorkout(statusId, userId, participantData) {
      let status = get(/databases/$(database)/documents/statuses/$(statusId)).data;
      let uid = request.auth.uid;
      let isAdmin = get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'user') == 'superadmin';
      return isSignedIn()
        && userId == uid
        && participantData.userId == uid
        && participantData.joinedAt is timestamp
        && status.type == 'workout'
        && status.workout.date > request.time
        && isMember(status.communityId, isAdmin);
    }

    match /statuses/{statusId} {
      allow read: if isSignedIn() && isMember(resource.data.communityId, isSuperAdmin());
      allow create: if canCreateStatus(request.resource.data, statusId);
      // AUD-003/AUD-004: o app nunca chama update() no documento de status (só
      // create/delete — votos e participações são subcoleções à parte, com suas
      // próprias regras). A versão anterior desta regra deixava authorUsername de
      // fora da lista de campos imutáveis (podia ser trocado após a publicação) e,
      // mais grave, permitia reescrever o conteúdo (texto, enquete, etc.) de uma
      // publicação já existente via acesso direto ao Firestore, depois de votos/
      // interações já registrados contra o conteúdo original. Bloquear update por
      // completo fecha os dois achados sem custo — nada no app depende disso.
      allow update: if false;
      // Fase 5: dono da comunidade também pode remover conteúdo dentro dela (mesmo
      // poder de moderação que o superadmin já tinha) -- isCommunityOwner só é avaliada
      // (pagando seu get() extra) quando as duas checagens mais baratas já falharam.
      allow delete: if isSignedIn()
        && (resource.data.authorId == request.auth.uid || isSuperAdmin()
          || isCommunityOwner(resource.data.communityId));

      match /votes/{userId} {
        allow read: if isSignedIn()
          && isMember(get(/databases/$(database)/documents/statuses/$(statusId)).data.communityId, isSuperAdmin());
        allow create: if canVote(statusId, userId, request.resource.data);
        allow update, delete: if false;
      }

      // Voto econômico (positivo/negativo, custa EvoCoins) -- Fase 2 do prompt de
      // economia. Deliberadamente uma subcoleção própria, nunca /votes acima: aquela é
      // o voto de ENQUETE, gratuito, sem nenhuma relação com carteira/ledger. Só a
      // Cloud Function voteOnPost (Admin SDK) escreve aqui -- write sempre false, mesmo
      // padrão de wallet/economyTransactions/economyDaily em users/{userId}.
      match /economyVotes/{userId} {
        allow read: if isOwner(userId) || isSuperAdmin();
        allow write: if false;
      }

      // Contador de recompensa por post/dia (Fase 3 -- reward-settlement-service.js).
      // Documento próprio, nunca um campo no status principal: statuses/{id} não tem
      // nenhum listener em tempo real hoje, mas a Fase 3 audita para não acoplar
      // bookkeeping econômico (escrito a cada execução do settlement) ao documento de
      // conteúdo do post (ver auditoria de Fase 3). Sem "dono" natural (é sobre o post,
      // não sobre um usuário) -- só superadmin lê, por enquanto sem uso no cliente.
      match /economyRewardDaily/{dateKey} {
        allow read: if isSuperAdmin();
        allow write: if false;
      }

      match /participants/{userId} {
        allow read: if isSignedIn()
          && isMember(get(/databases/$(database)/documents/statuses/$(statusId)).data.communityId, isSuperAdmin());
        allow create: if canJoinWorkout(statusId, userId, request.resource.data);
        allow delete: if isSignedIn() && userId == request.auth.uid;
        allow update: if false;
      }
    }

    // MAX_ACTIVE_ADS_PER_COMMUNITY (quantos anúncios podem mirar a mesma comunidade) só
    // existe em sponsoredAdsService.js, de propósito — regras não conseguem rodar uma
    // contagem/aggregation, então esse teto não é (e não pode ser) reforçado aqui. Ver o
    // comentário em assertUnderActiveAdsCap() para as duas lacunas conhecidas e aceitas
    // dessa decisão.
    // Sem allowlist de esquema, ctaTarget era texto livre renderizado direto como href
    // no client — um valor 'javascript:...' executava no clique, na origem real do app,
    // contra qualquer membro das comunidades do anúncio (achado #1 da auditoria de
    // segurança). Espelha EXTERNAL_CTA_TARGET_PATTERN/INTERNAL_CTA_TARGET_PATTERN em
    // validators.js — nunca confiar só na regra nem só no client.
    function isValidCtaTarget(data) {
      return data.ctaType == 'external'
        ? data.ctaTarget.matches('^https://.+$')
        // Uma barra só (não duas): "//evil.com" é uma URL "protocol-relative" válida
        // que o navegador resolve para outro domínio, e "/\\evil.com" corre o mesmo
        // risco por normalização de barra invertida em alguns navegadores.
        : data.ctaTarget.matches('^/([^/\\\\].*)?$');
    }

    function isValidSponsoredAd(data) {
      return data.partnerName is string && data.partnerName.size() > 0 && data.partnerName.size() <= 60
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() <= 500
        && (data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 500))
        && (data.ctaLabel == null || (data.ctaLabel is string && data.ctaLabel.size() <= 30))
        // ctaType/ctaTarget existem se e somente se ctaLabel existe — mesma regra
        // condicional de validateSponsoredAd() em validators.js.
        && (data.ctaLabel != null) == (data.ctaType != null)
        && (data.ctaType == null || data.ctaType in ['external', 'internal'])
        && (data.ctaLabel != null) == (data.ctaTarget != null)
        && (data.ctaTarget == null
          || (data.ctaTarget is string && data.ctaTarget.size() <= 300 && isValidCtaTarget(data)))
        && (data.expiresAt == null || data.expiresAt is timestamp)
        // isGlobal e communityIds são ortogonais, não mutuamente exclusivos: um anúncio
        // pode mirar só comunidades específicas, só a Home (isGlobal), ou os dois ao
        // mesmo tempo — o único estado inválido é não aparecer em lugar nenhum.
        && data.isGlobal is bool
        && data.communityIds is list && data.communityIds.size() <= 50
        && (data.communityIds.size() >= 1 || data.isGlobal == true)
        && data.displayMode is list && data.displayMode.size() >= 1
        && data.displayMode.hasOnly(['feed', 'banner'])
        && data.createdBy is string
        && data.createdAt is timestamp;
    }

    match /sponsoredAds/{adId} {
      // Um anúncio só é visível pra quem participa de pelo menos uma das comunidades
      // listadas em communityIds, OU pra qualquer usuário autenticado quando isGlobal é
      // true (banner da Home, sem relação com comunidades) — nunca liberado geral por
      // padrão. isSuperAdmin() entra primeiro porque o painel admin precisa listar/editar
      // TODOS os anúncios, não só os das comunidades de que o próprio admin participa.
      //
      // isGlobal vem ANTES de communityIds.hasAny(...) no || de propósito: CEL faz
      // short-circuit, então consultar anúncios globais (Home) nunca chega a avaliar
      // myCommunityIds() (que faz um get() extra em users/{uid}) — mais barato, não mais
      // caro, que a consulta por comunidade.
      //
      // IMPORTANTE pra quem for consumir esta coleção no client: como esta regra depende
      // de um get() que não faz parte do filtro da própria query, o Firestore nega a
      // consulta INTEIRA (não filtra documento a documento) se QUALQUER resultado
      // possível não bater com a regra pro usuário atual. Isso é seguro e correto desde
      // que a query só seja feita com um communityId que o usuário já confirmou
      // participar (mesmo padrão de CommunityDetail.jsx, que só busca o feed depois de
      // isMember() == true) — nesse caso, o próprio filtro array-contains da query já
      // garante a interseção com myCommunityIds(). NUNCA consultar communityIds de uma
      // comunidade não confirmada antes — o pedido inteiro seria negado, não filtrado.
      // A consulta global (where isGlobal == true) não tem esse risco: todo resultado
      // possível já bate com o primeiro branch do ||, para qualquer usuário autenticado.
      allow read: if isSuperAdmin()
        || (isSignedIn()
          && (resource.data.get('isGlobal', false) == true
            || resource.data.communityIds.hasAny(myCommunityIds())));
      allow create: if isSuperAdmin()
        && isValidSponsoredAd(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSuperAdmin()
        && isValidSponsoredAd(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
