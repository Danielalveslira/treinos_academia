{
  "name": "treinos-academia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:catalog": "node scripts/build-exercise-catalog.mjs",
    "build:catalog-images": "node scripts/build-exercise-catalog-images.mjs",
    "build:catalog-images:dry-run": "node scripts/build-exercise-catalog-images.mjs --dry-run",
    "build:catalog-images:apply": "node scripts/build-exercise-catalog-images.mjs --apply",
    "backfill:progress:dry-run": "node scripts/backfill-progress-daily.mjs",
    "backfill:progress:apply": "node scripts/backfill-progress-daily.mjs --apply",
    "backfill:community-owner:dry-run": "node scripts/backfill-community-owner-id.mjs",
    "backfill:community-owner:apply": "node scripts/backfill-community-owner-id.mjs --apply",
    "upload:catalog-images": "node scripts/upload-exercise-catalog-images.mjs",
    "upload:catalog-images:dry-run": "node scripts/upload-exercise-catalog-images.mjs --dry-run",
    "upload:catalog-images:apply": "node scripts/upload-exercise-catalog-images.mjs --apply",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test src/**/*.test.js",
    "test:backfill": "node --test scripts/*.test.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\"",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo",
    "test:rules": "node --test --test-concurrency=1 tests/*rules.test.mjs"
  },
  "dependencies": {
    "@primer/octicons-react": "^19.35.0",
    "@primer/primitives": "^11.10.0",
    "@primer/react": "^37.31.0",
    "firebase": "^11.0.2",
    "lucide-react": "^1.44.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.13.3",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "firebase-admin": "^14.4.0",
    "globals": "^15.12.0",
    "prettier": "^3.9.6",
    "react-test-renderer": "^18.3.1",
    "sharp": "^0.34.5",
    "vite": "^5.4.11"
  }
}
