{
  "name": "treinos-academia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-public-pages.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 \"src/**/*.test.js\"",
    "test:backfill": "node --test scripts/*.test.mjs",
    "test:functions": "node --test --test-concurrency=1 supabase/functions/*/*.test.js",
    "release:offline-check": "node scripts/release-offline-check.mjs",
    "release:offline-config": "node scripts/check-offline-release-config.mjs",
    "test:offline-browser": "node scripts/offline-browser-smoke.mjs",
    "budget": "node scripts/bundle-budget.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\""
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^2.2.0",
    "@hotwired/turbo": "^8.0.23",
    "@primer/octicons-react": "^19.35.0",
    "@primer/primitives": "^11.10.0",
    "@primer/react": "^37.31.0",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "lucide-react": "^1.44.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.13.3",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.12.0",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.6",
    "react-test-renderer": "^18.3.1",
    "supabase": "^2.119.0",
    "vite": "^7.3.7"
  }
}
